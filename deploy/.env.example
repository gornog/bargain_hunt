# Copy this file to .env on the Docker machine. Never commit the completed file.
POCKETBASE_SUPERUSER_EMAIL=admin@example.invalid
POCKETBASE_SUPERUSER_PASSWORD=replace-with-the-PocketBase-superuser-password
SITE_EDITOR_USERNAME=editor
SITE_EDITOR_PASSWORD=replace-with-a-long-unique-password
# Change this only if port 4321 is already in use on the Docker host.
APP_PORT=4321
