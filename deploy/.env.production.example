# Copy to a private Portainer stack environment / secrets store. Never commit the real values.
POCKETBASE_URL=http://pocketbase:8090
# PocketBase does not use traditional API keys. Use an existing superuser account.
POCKETBASE_SUPERUSER_EMAIL=you@example.com
POCKETBASE_SUPERUSER_PASSWORD=replace-with-the-superuser-password
SITE_EDITOR_USERNAME=editor
SITE_EDITOR_PASSWORD=replace-with-a-long-random-password
