---
import PersonCombobox from './PersonCombobox.astro';
const { color, label, experts, performance, auctionHouses = [], auctioneers = [] } = Astro.props;
const tone = color === 'red' ? 'team-red' : 'team-blue';
const eligibleExperts = experts.filter((expert: any) => expert.is_expert);
const field = (name: string) => performance?.[name] ?? '';
const checked = (name: string) => Boolean(performance?.[name]);
const items = performance?.items ?? [];
const itemFor = (slot: number) => items.find((item: any) => Number(item.slot) === slot);
const itemValue = (slot: number, name: string) => itemFor(slot)?.[name] ?? (slot < 4 ? performance?.[`item_${slot}_${name === 'buy_price' ? 'buy' : name === 'sell_price' ? 'sell' : name}`] : performance?.[`bonus_${name === 'buy_price' ? 'buy' : name === 'sell_price' ? 'sell' : name}`]) ?? '';
const itemChecked = (slot: number, name: string) => Boolean(itemFor(slot)?.[name] ?? (slot < 4 ? performance?.[`item_${slot}_${name}`] : false));
---
<fieldset class={`team-card ${tone}`}>
  <legend><span class="team-dot"></span>{label}<small>Purchases & sales</small></legend>
  <label>Assigned expert<PersonCombobox id={`${color}-expert`} name={`${color}_expert`} experts={eligibleExperts.length ? eligibleExperts : experts} value={performance?.expand?.expert?.name ?? ''} placeholder="Start typing an expert" /></label>
  <label>Result entry<select name={`${color}_result_mode`}><option value="items" selected={field('result_mode') !== 'final'}>Item prices</option><option value="final" selected={field('result_mode') === 'final'}>Final profit only</option></select></label>
  <label class="final-profit">Final profit<input type="number" step="0.01" name={`${color}_final_profit`} value={field('final_profit')} placeholder="£ 0" /></label>
  <div class="item-head"><span>Item</span><span>Paid</span><span>Sold</span></div>
  {[1, 2, 3, 4].map((slot) => { const item = slot === 4 ? 'bonus' : String(slot); return <div class={`item-editor ${slot === 4 ? 'bonus-row' : ''}`}><div class="item-row"><input type="text" name={`${color}_item_${slot}_name`} value={itemValue(slot, 'name')} aria-label={`${label} ${item} name`} placeholder={`${slot === 4 ? 'Bonus item' : `Item ${slot}`} description`} /><input type="number" step="0.01" name={`${color}_item_${slot}_buy`} value={itemValue(slot, 'buy_price')} aria-label={`${label} ${item} paid`} placeholder="£ 0" /><input type="number" step="0.01" name={`${color}_item_${slot}_sell`} value={itemValue(slot, 'sell_price')} aria-label={`${label} ${item} sold`} placeholder="£ 0" /></div><div class="item-options"><label class="check"><input type="checkbox" name={`${color}_item_${slot}_challenge`} checked={itemChecked(slot, 'is_challenge')} /> Challenge</label><label class="check"><input type="checkbox" name={`${color}_item_${slot}_big_spend`} checked={itemChecked(slot, 'is_big_spend')} /> Big spend</label><label class="check"><input type="checkbox" name={`${color}_item_${slot}_disqualified`} checked={itemChecked(slot, 'disqualified') || (slot < 4 && checked(`item_${slot}_disqualified`))} /> Disqualified</label><label>Challenge result<select name={`${color}_item_${slot}_challenge_result`}><option value="not_applicable" selected={itemFor(slot)?.challenge_result === 'not_applicable' || !itemFor(slot)?.challenge_result}>N/A</option><option value="passed" selected={itemFor(slot)?.challenge_result === 'passed'}>Passed</option><option value="failed" selected={itemFor(slot)?.challenge_result === 'failed'}>Failed</option></select></label><label>Auction house<select name={`${color}_item_${slot}_auction_house`}><option value="">Not recorded</option>{auctionHouses.map((house: any) => <option value={house.id} selected={itemFor(slot)?.auction_house === house.id}>{house.name}</option>)}</select></label><label>Auctioneer(s)<select name={`${color}_item_${slot}_auctioneers`} multiple size="2">{auctioneers.map((auctioneer: any) => <option value={auctioneer.id} selected={itemFor(slot)?.auctioneer?.includes?.(auctioneer.id)}>{auctioneer.name}</option>)}</select></label><label>Top estimate<input type="number" step="0.01" name={`${color}_item_${slot}_estimate`} value={itemValue(slot, 'auctioneer_estimate')} placeholder="£ 0" /></label></div>{slot === 4 && <label class="check"><input type="checkbox" name={`${color}_bonus_accepted`} checked={checked('bonus_accepted')} /> Bonus accepted</label>}</div>; })}
  <output class="team-total" data-team-total={color}>Current result: £0.00</output>
</fieldset>
