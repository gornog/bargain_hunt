---
const { color, label, experts } = Astro.props;
const tone = color === 'red' ? 'team-red' : 'team-blue';
---
<fieldset class={`team-card ${tone}`}>
  <legend><span class="team-dot"></span>{label}<small>Purchases & sales</small></legend>
  <label>Assigned expert<input type="text" name={`${color}_expert`} list="expert-list" placeholder="Start typing a name" /></label>
  <div class="item-head"><span>Item</span><span>Paid</span><span>Sold</span></div>
  {[1, 2, 3].map((item) => <div class="item-row"><input type="text" name={`${color}_item_${item}_name`} aria-label={`${label} item ${item} name`} placeholder={`Item ${item} description`} /><input type="number" step="0.01" name={`${color}_item_${item}_buy`} aria-label={`${label} item ${item} paid`} placeholder="£ 0" /><input type="number" step="0.01" name={`${color}_item_${item}_sell`} aria-label={`${label} item ${item} sold`} placeholder="£ 0" /></div>)}
  <div class="item-row bonus-row"><input type="text" name={`${color}_bonus_name`} aria-label={`${label} bonus item name`} placeholder="Bonus item (optional)" /><input type="number" step="0.01" name={`${color}_bonus_buy`} aria-label={`${label} bonus paid`} placeholder="£ 0" /><input type="number" step="0.01" name={`${color}_bonus_sell`} aria-label={`${label} bonus sold`} placeholder="£ 0" /></div>
  <label class="check"><input type="checkbox" name={`${color}_bonus_accepted`} /> Bonus accepted</label>
</fieldset>
