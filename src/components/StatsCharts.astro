---
const { bins = [], episodes = [], mode = 'both' } = Astro.props;
const payload = JSON.stringify({ bins, episodes, mode }).replace(/</g, '\\u003c');
---
<div class="stats-chart-pair" data-stats-charts={payload}>
  {mode !== 'episode' && <div class="stats-chart"><canvas aria-label="Team profit histogram" role="img"></canvas></div>}
  {mode !== 'histogram' && <div class="stats-chart"><canvas aria-label="Net result by episode" role="img"></canvas></div>}
</div>
<script is:inline src="/vendor/chart.umd.js"></script>
<script>
  const Chart = (window as any).Chart;
  const money = new Intl.NumberFormat('en-GB', { style:'currency', currency:'GBP', maximumFractionDigits:0 });
  const animated = { duration: 720, easing: 'easeOutQuart' as const };
  const gradient = (canvas: HTMLCanvasElement, colour: string) => {
    const context = canvas.getContext('2d');
    if (!context) return colour;
    const fill = context.createLinearGradient(0, 0, 0, canvas.height || 300);
    fill.addColorStop(0, `${colour}f2`);
    fill.addColorStop(1, `${colour}70`);
    return fill;
  };
  const init = () => document.querySelectorAll<HTMLElement>('[data-stats-charts]').forEach((root) => {
    if (root.dataset.ready) return;
    const canvases = root.querySelectorAll('canvas');
    if (!Chart || !canvases.length) return;
    const data = JSON.parse(root.dataset.statsCharts || '{}'); root.dataset.ready = 'true';
    let index = 0;
    if (data.mode !== 'episode') {
      const canvas = canvases[index++] as HTMLCanvasElement;
      const binColours = data.bins.map((bin:any) => bin.max < 0 ? '#ed2638' : bin.min === 0 && bin.max === 0 ? '#ffd04a' : '#2587d6');
      new Chart(canvas, { type:'bar', data:{ labels:data.bins.map((b:any)=>b.label), datasets:[{ data:data.bins.map((b:any)=>b.count), backgroundColor:data.bins.map((_:any, index:number)=>gradient(canvas, binColours[index])), borderColor:binColours, borderWidth:1, borderRadius:7, borderSkipped:false, maxBarThickness:56 }] }, options:{ responsive:true, maintainAspectRatio:false, animation:animated, interaction:{intersect:false,mode:'index'}, plugins:{ legend:{display:false}, tooltip:{ displayColors:false, backgroundColor:'#fffdf5', titleColor:'#111722', bodyColor:'#354055', borderColor:'#d1b24b', borderWidth:1, padding:10, callbacks:{ title:(items:any[])=>items[0]?.label || '', label:(context:any)=>`${context.raw} recorded team${context.raw === 1 ? '' : 's'}` } } }, scales:{ x:{ticks:{color:'#c9d0d9',font:{weight:'600'}},grid:{display:false},border:{color:'rgba(244,241,232,.25)'}}, y:{beginAtZero:true,ticks:{precision:0,color:'#c9d0d9',stepSize:1},grid:{color:'rgba(244,241,232,.11)'},border:{display:false}} } } });
    }
    if (data.mode !== 'histogram') {
      const canvas = canvases[index] as HTMLCanvasElement;
      const resultColours = data.episodes.map((entry:any)=>entry.profit < 0 ? '#ed2638' : '#2587d6');
      new Chart(canvas, { type:'bar', data:{ labels:data.episodes.map((e:any)=>e.label), datasets:[{ data:data.episodes.map((e:any)=>e.profit), backgroundColor:resultColours.map((colour:string)=>gradient(canvas, colour)), borderColor:resultColours, borderWidth:1, borderRadius:6, borderSkipped:false, maxBarThickness:38 }] }, options:{ responsive:true, maintainAspectRatio:false, animation:animated, interaction:{intersect:false,mode:'index'}, plugins:{ legend:{display:false}, tooltip:{ displayColors:false, backgroundColor:'#fffdf5', titleColor:'#111722', bodyColor:'#354055', borderColor:'#d1b24b', borderWidth:1, padding:10, callbacks:{ title:(items:any[])=>items[0]?.label || '', label:(context:any)=>`Combined result: ${money.format(Number(context.raw))}` } } }, scales:{ x:{ticks:{color:'#c9d0d9',maxRotation:60,autoSkip:true,font:{weight:'600'}},grid:{display:false},border:{color:'rgba(244,241,232,.25)'}}, y:{ticks:{color:'#c9d0d9',callback:(value:any)=>money.format(value),stepSize:10},grid:{color:(context:any)=>context.tick.value === 0 ? 'rgba(255,208,74,.75)' : 'rgba(244,241,232,.11)',lineWidth:(context:any)=>context.tick.value === 0 ? 1.4 : 1},border:{display:false}} } } });
    }
  });
  requestAnimationFrame(init);
</script>
