---
const { bins = [], episodes = [], mode = 'both' } = Astro.props;
const payload = JSON.stringify({ bins, episodes, mode }).replace(/</g, '\\u003c');
---
<div class="stats-chart-pair" data-stats-charts={payload}>
  {mode !== 'episode' && <div class="stats-chart"><canvas aria-label="Team profit histogram" role="img"></canvas></div>}
  {mode !== 'histogram' && <div class="stats-chart"><canvas aria-label="Net result by episode" role="img"></canvas></div>}
</div>
<script is:inline src="/vendor/chart.umd.js"></script>
<script>
  const Chart = (window as any).Chart;
  const money = new Intl.NumberFormat('en-GB', { style:'currency', currency:'GBP', maximumFractionDigits:0 });
  const init = () => document.querySelectorAll<HTMLElement>('[data-stats-charts]').forEach((root) => {
    if (root.dataset.ready) return;
    const canvases = root.querySelectorAll('canvas');
    if (!Chart || !canvases.length) return;
    const data = JSON.parse(root.dataset.statsCharts || '{}'); root.dataset.ready = 'true';
    let index = 0;
    if (data.mode !== 'episode') { new Chart(canvases[index++] as HTMLCanvasElement, { type:'bar', data:{ labels:data.bins.map((b:any)=>b.label), datasets:[{ data:data.bins.map((b:any)=>b.count), backgroundColor:['#ed2638','#ed2638','#2587d6','#2587d6','#ffd04a'], borderRadius:4 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, scales:{ x:{ticks:{color:'#b8c0c9'}}, y:{beginAtZero:true, ticks:{precision:0, color:'#b8c0c9', stepSize:1}, grid:{color:'rgba(244,241,232,.13)'}} } } }); }
    if (data.mode !== 'histogram') { new Chart(canvases[index] as HTMLCanvasElement, { type:'bar', data:{ labels:data.episodes.map((e:any)=>e.label), datasets:[{ data:data.episodes.map((e:any)=>e.profit), backgroundColor:data.episodes.map((e:any)=>e.profit < 0 ? '#ed2638' : '#2587d6'), borderRadius:3 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{ callbacks:{ label:(ctx:any)=>money.format(ctx.raw) } } }, scales:{ x:{ticks:{color:'#b8c0c9', maxRotation:60, autoSkip:true}}, y:{ticks:{color:'#b8c0c9', callback:(v:any)=>money.format(v), stepSize:10}, grid:{color:'rgba(244,241,232,.13)'}} } } }); }
  });
  requestAnimationFrame(init);
</script>
