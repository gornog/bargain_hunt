---
import Layout from '../layouts/Layout.astro';
import Team from '../components/Team.astro';
import { loadArchive, value, pb } from '../lib/archive';

let experts: any[] = [], details: any[] = [], errorMessage = '';
try { ({ experts, details } = await loadArchive()); } catch (error) { errorMessage = 'PocketBase is unavailable. Check that the database container is running.'; console.error(error); }
const selectedEpisodeId = Astro.url.searchParams.get('episode');
const selectedEpisode = details.find((episode) => episode.id === selectedEpisodeId);

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const findExpert = (name: string) => experts.find((expert) => expert.name.toLowerCase() === name.toLowerCase());
    const episode = await pb.collection('episodes').create({ series: value(form.get('series')), episod_number: value(form.get('episode_number')), title: String(form.get('title') || '').trim(), broadcast_date: String(form.get('air_date') || ''), presenter: findExpert(String(form.get('presenter') || '').trim())?.id || '' });
    for (const color of ['red', 'blue']) {
      const record: Record<string, unknown> = { episode: episode.id, team_color: color === 'red' ? 'Red' : 'Blue', expert: findExpert(String(form.get(`${color}_expert`) || '').trim())?.id || '', bonus_accepted: form.get(`${color}_bonus_accepted`) === 'on' };
      for (const item of [1, 2, 3]) { record[`item_${item}_name`] = String(form.get(`${color}_item_${item}_name`) || '').trim(); record[`item_${item}_buy`] = value(form.get(`${color}_item_${item}_buy`)); record[`item_${item}_sell`] = value(form.get(`${color}_item_${item}_sell`)); record[`item_${item}_disqualified`] = form.get(`${color}_item_${item}_disqualified`) === 'on'; }
      record.bonus_name = String(form.get(`${color}_bonus_name`) || '').trim(); record.bonus_buy = value(form.get(`${color}_bonus_buy`)); record.bonus_sell = value(form.get(`${color}_bonus_sell`));
      await pb.collection('team_performances').create(record);
    }
    return Astro.redirect('/episodes');
  } catch (error) { errorMessage = 'The episode could not be saved. Check the PocketBase rules and field names.'; console.error(error); }
}
---
<Layout>
  <div class="shell">
    <header class="topbar"><a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/experts">Experts</a><a href="/stats">Stats</a></nav></header>
    <main class="directory log-page">
      <div class="page-intro"><p class="eyebrow">episode rating</p><h1>Record the <i>result.</i></h1><p>Enter item prices when you have them, or use the final profit shortcut. An episode becomes in progress until both teams are represented.</p></div>
      {errorMessage && <div class="notice error">{errorMessage}</div>}
      <form method="POST" class="log-form"><div class="form-block"><div class="block-label">Episode details <span>Required context</span></div><div class="fields four"><label>Series<input type="number" name="series" min="1" required value={selectedEpisode?.series ?? ''} placeholder="40" /></label><label>Episode<input type="number" name="episode_number" min="1" required value={selectedEpisode?.episod_number ?? ''} placeholder="12" /></label><label class="wide">Title / location<input type="text" name="title" value={selectedEpisode?.title ?? ''} placeholder="e.g. Ardingly Antiques Fair" /></label><label>Date<input type="date" name="air_date" value={selectedEpisode?.broadcast_date?.slice(0, 10) ?? ''} /></label><label class="wide">Presenter<input type="text" name="presenter" list="expert-list" value={selectedEpisode?.expand?.presenter?.name ?? ''} placeholder="Start typing a name" /></label></div></div><div class="teams"><Team color="red" label="Red team" experts={experts} /><Team color="blue" label="Blue team" experts={experts} /></div><datalist id="expert-list">{experts.map((expert) => <option value={expert.name} />)}</datalist><div class="form-actions"><p>Use item prices or enter a final profit.</p><button type="submit">Save episode <span>↗</span></button></div></form>
    </main>
    <footer><span>BARGAIN HUNT / FIELD NOTES</span><span>Episode rating</span></footer>
  </div>
</Layout>
<script>
  document.querySelector('form.log-form')?.addEventListener('submit', () => {
    for (const color of ['red', 'blue']) {
      const mode = document.querySelector(`[name="${color}_result_mode"]`); const finalValue = document.querySelector(`[name="${color}_final_profit"]`); const name = document.querySelector(`[name="${color}_item_1_name"]`); const buy = document.querySelector(`[name="${color}_item_1_buy"]`); const sell = document.querySelector(`[name="${color}_item_1_sell"]`);
      if (mode?.value === 'final' && name && buy && sell && finalValue) { name.value = 'Final result'; buy.value = '0'; sell.value = finalValue.value; }
    }
  });
</script>
