---
import Layout from '../layouts/Layout.astro';
import Team from '../components/Team.astro';
import PersonCombobox from '../components/PersonCombobox.astro';
import { loadArchive, value, fileUrl, pb } from '../lib/archive';

let experts: any[] = [], details: any[] = [], auctionHouses: any[] = [], auctioneers: any[] = [], errorMessage = '';
try { ({ experts, details, auctionHouses, auctioneers } = await loadArchive()); } catch (error) { errorMessage = 'PocketBase is unavailable. Check that the database container is running.'; console.error(error); }
const selectedEpisodeId = Astro.url.searchParams.get('episode');
const selectedEpisode = details.find((episode) => episode.id === selectedEpisodeId);
const unnumbered = details.filter((episode) => !Number(episode.episod_number));
const presenters = experts.filter((expert) => expert.is_presenter);
const selectedWinner = selectedEpisode?.scored?.[0];

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const findExpert = (name: string) => experts.find((expert) => expert.name.toLowerCase() === name.toLowerCase());
    const episodeData = { series: value(form.get('series')), episod_number: value(form.get('episode_number')), title: String(form.get('title') || '').trim(), broadcast_date: String(form.get('air_date') || ''), presenter: findExpert(String(form.get('presenter') || '').trim())?.id || '', auction_house: String(form.get('auction_house') || ''), auctioneers: form.getAll('auctioneers').map(String) };
    const catalogueId = String(form.get('catalogue_episode') || '').trim() || selectedEpisodeId || '';
    const matchingEpisode = details.find((candidate) => Number(candidate.series) === episodeData.series && Number(candidate.episod_number) === episodeData.episod_number && episodeData.episod_number > 0);
    const episode = catalogueId ? await pb.collection('episodes').update(catalogueId, episodeData) : matchingEpisode ? await pb.collection('episodes').update(matchingEpisode.id, episodeData) : await pb.collection('episodes').create(episodeData);
    const existingPerformances = await pb.collection('team_performances').getFullList({ filter: `episode = "${episode.id}"`, requestKey: null });
    for (const color of ['red', 'blue']) {
      const teamColor = color === 'red' ? 'Red' : 'Blue';
      const record: Record<string, unknown> = { episode: episode.id, team_color: teamColor, expert: findExpert(String(form.get(`${color}_expert`) || '').trim())?.id || '', result_mode: String(form.get(`${color}_result_mode`) || 'items'), final_profit: value(form.get(`${color}_final_profit`)), bonus_accepted: form.get(`${color}_bonus_accepted`) === 'on' };
      for (const item of [1, 2, 3]) { record[`item_${item}_name`] = String(form.get(`${color}_item_${item}_name`) || '').trim(); record[`item_${item}_buy`] = value(form.get(`${color}_item_${item}_buy`)); record[`item_${item}_sell`] = value(form.get(`${color}_item_${item}_sell`)); record[`item_${item}_disqualified`] = form.get(`${color}_item_${item}_disqualified`) === 'on'; }
      record.bonus_name = String(form.get(`${color}_item_4_name`) || '').trim(); record.bonus_buy = value(form.get(`${color}_item_4_buy`)); record.bonus_sell = value(form.get(`${color}_item_4_sell`));
      const existing = existingPerformances.find((performance) => performance.team_color === teamColor);
      const savedPerformance = existing ? await pb.collection('team_performances').update(existing.id, record) : await pb.collection('team_performances').create(record);
      const existingItems = await pb.collection('items').getFullList({ filter: `team_performance = "${savedPerformance.id}"`, requestKey: null });
      for (const slot of [1, 2, 3, 4]) {
        const name = String(form.get(`${color}_item_${slot}_name`) || '').trim();
        const buyPrice = value(form.get(`${color}_item_${slot}_buy`));
        const sellPrice = value(form.get(`${color}_item_${slot}_sell`));
        const estimate = value(form.get(`${color}_item_${slot}_estimate`));
        const accepted = slot === 4 && form.get(`${color}_bonus_accepted`) === 'on';
        const challenge = form.get(`${color}_item_${slot}_challenge`) === 'on';
        const bigSpend = form.get(`${color}_item_${slot}_big_spend`) === 'on';
        const disqualified = form.get(`${color}_item_${slot}_disqualified`) === 'on';
        const hasContent = Boolean(name || buyPrice || sellPrice || estimate || challenge || bigSpend || disqualified || accepted);
        const item = existingItems.find((entry) => Number(entry.slot) === slot);
        if (!hasContent && !item) continue;
        const itemData = { team_performance: savedPerformance.id, slot, name, buy_price: buyPrice, sell_price: sellPrice, auctioneer_estimate: estimate, is_challenge: challenge, is_big_spend: bigSpend, disqualified, challenge_result: challenge ? String(form.get(`${color}_item_${slot}_challenge_result`) || 'passed') : 'not_applicable' };
        if (item) await pb.collection('items').update(item.id, itemData);
        else await pb.collection('items').create(itemData);
      }
    }
    return Astro.redirect('/episodes');
  } catch (error) { errorMessage = 'The episode could not be saved. Check the PocketBase rules and field names.'; console.error(error); }
}
---
<Layout>
  <div class="shell">
    <header class="topbar"><a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/log">Log</a><a href="/experts">Experts</a><a href="/stats">Stats</a></nav></header>
    <main class="directory log-page">
      <div class="page-intro"><p class="eyebrow">auction room</p><h1>Enter the <i>result.</i></h1><p>Record the buys, the sales, the bonus buy and the final score. Item prices are welcome, but a final result is enough.</p></div>
      {errorMessage && <div class="notice error">{errorMessage}</div>}
      {selectedWinner && <section class="winner-banner"><strong>Winner: {selectedWinner.team_color} team</strong><span>{selectedEpisode?.scored.map((team: any) => `${team.team_color} team ${team.profit < 0 ? '-' : ''}£${Math.abs(team.profit).toFixed(2)}`).join(' · ')}</span></section>}
      <form method="POST" class="log-form"><div class="form-block"><div class="block-label">Episode details <span>Required context</span></div><div class="fields four"><label>Series<input id="series-input" type="number" name="series" min="1" required value={selectedEpisode?.series ?? ''} placeholder="40" /></label><label>Episode<input id="episode-input" type="number" name="episode_number" min="1" required value={selectedEpisode?.episod_number ?? ''} placeholder="12" /></label><label class="wide">Title / location<input id="title-input" type="text" name="title" value={selectedEpisode?.title ?? ''} placeholder="e.g. Ardingly Antiques Fair" /></label><label>Watch date<input id="date-input" type="date" name="air_date" value={selectedEpisode?.broadcast_date?.slice(0, 10) ?? ''} /></label><label class="wide">Presenter<PersonCombobox id="presenter-input" name="presenter" experts={presenters.length ? presenters : experts} value={selectedEpisode?.expand?.presenter?.name ?? ''} placeholder="Start typing a presenter" /></label><label>Auction house<select name="auction_house"><option value="">Not recorded</option>{auctionHouses.map((house: any) => <option value={house.id} selected={selectedEpisode?.auction_house === house.id}>{house.name}</option>)}</select></label><label>Auctioneer(s)<select name="auctioneers" multiple size="2">{auctioneers.map((auctioneer: any) => <option value={auctioneer.id} selected={selectedEpisode?.auctioneers?.includes?.(auctioneer.id)}>{auctioneer.name}</option>)}</select></label></div><label id="catalogue-picker" class="catalogue-picker is-hidden">BBC entry to associate<select id="catalogue-select" name="catalogue_episode"><option value="">Choose an unnumbered BBC entry</option>{unnumbered.map((episode) => <option value={episode.id} data-series={episode.series} data-title={episode.title || ''} data-image={episode.image ? fileUrl(episode, episode.image) : ''}>{`Series ${episode.series || 'n/a'}: ${episode.title || 'Untitled entry'}`}</option>)}</select><small>Use this when the BBC page supplied the series entry but not its episode number.</small></label>{selectedEpisode?.image && <img id="episode-preview" class="log-preview" src={fileUrl(selectedEpisode, selectedEpisode.image)} alt={selectedEpisode.title || 'Episode image'} />}{selectedEpisode?.synopsis && <p class="log-synopsis">{selectedEpisode.synopsis}</p>}</div><div class="teams"><Team color="red" label="Red team" experts={experts} performance={selectedEpisode?.teams.find((team: any) => team.team_color === 'Red')} /><Team color="blue" label="Blue team" experts={experts} performance={selectedEpisode?.teams.find((team: any) => team.team_color === 'Blue')} /></div><div class="form-actions"><p>Draft is kept on this device while you work.</p><button type="submit">Save episode <span>↗</span></button></div></form>
    </main>
    <footer><span>BARGAIN HUNT / FIELD NOTES</span><span>Episode rating</span></footer>
  </div>
</Layout>
<script define:vars={{ catalogue: details.map((episode) => ({ id: episode.id, series: episode.series, number: episode.episod_number, title: episode.title || '', date: episode.broadcast_date || '', presenter: episode.expand?.presenter?.name || '', image: episode.image ? fileUrl(episode, episode.image) : '' })), selectedId: selectedEpisodeId }}>
  const form = document.querySelector('form.log-form'); const seriesInput = document.querySelector('#series-input'); const episodeInput = document.querySelector('#episode-input'); const titleInput = document.querySelector('#title-input'); const dateInput = document.querySelector('#date-input'); const presenterInput = document.querySelector('#presenter-input'); const picker = document.querySelector('#catalogue-picker'); const select = document.querySelector('#catalogue-select'); const draftKey = `bargain-hunt-log:${selectedId || 'new'}`;
  const preview = (src, alt) => { let image = document.querySelector('#episode-preview'); if (!src) { image?.remove(); return; } if (!image) { image = document.createElement('img'); image.id = 'episode-preview'; image.className = 'log-preview'; document.querySelector('.form-block')?.append(image); } image.src = src; image.alt = alt || 'Episode image'; };
  const fill = (episode) => { if (!episode) return; titleInput.value = episode.title; dateInput.value = episode.date ? episode.date.slice(0, 10) : ''; presenterInput.value = episode.presenter; preview(episode.image, episode.title); document.querySelector('.log-synopsis')?.replaceChildren(episode.synopsis || ''); };
  const refreshMatch = () => { const s = Number(seriesInput.value); const n = Number(episodeInput.value); const exact = catalogue.find((episode) => Number(episode.series) === s && Number(episode.number) === n && n > 0); if (exact) { select.value = exact.id; picker.classList.add('is-hidden'); fill(exact); return; } const candidates = [...select.options].filter((option) => option.value && Number(option.dataset.series) === s); picker.classList.toggle('is-hidden', !s || !n || Boolean(exact) || !candidates.length); if (select.value && !candidates.some((option) => option.value === select.value)) select.value = ''; };
  seriesInput?.addEventListener('input', refreshMatch); episodeInput?.addEventListener('input', refreshMatch); select?.addEventListener('change', () => { const selected = catalogue.find((episode) => episode.id === select.value); if (selected) fill(selected); });
  if (selectedId) refreshMatch();
  const updateTotals = () => { for (const color of ['red', 'blue']) { const mode = document.querySelector(`[name="${color}_result_mode"]:checked`); const card = mode?.closest('.team-card'); const output = document.querySelector(`[data-team-total="${color}"]`); card?.classList.toggle('final-mode', mode?.value === 'final'); let total = Number(document.querySelector(`[name="${color}_final_profit"]`)?.value || 0); if (mode?.value !== 'final') { total = 0; for (const item of [1, 2, 3]) { const buy = Number(document.querySelector(`[name="${color}_item_${item}_buy"]`)?.value || 0); const sellInput = document.querySelector(`[name="${color}_item_${item}_sell"]`); const disqualified = document.querySelector(`[name="${color}_item_${item}_disqualified"]`)?.checked; const challengeFailed = document.querySelector(`[name="${color}_item_${item}_challenge_result"]`)?.value === 'failed'; total += (disqualified || challengeFailed ? 0 : Number(sellInput?.value || 0)) - buy; } const bonusAccepted = document.querySelector(`[name="${color}_bonus_accepted"]`)?.checked; if (bonusAccepted) total += Number(document.querySelector(`[name="${color}_item_4_sell"]`)?.value || 0) - Number(document.querySelector(`[name="${color}_item_4_buy"]`)?.value || 0); } if (output) { output.textContent = `${color === 'red' ? 'Red' : 'Blue'} result: ${total < 0 ? '-' : ''}£${Math.abs(total).toFixed(2)}`; output.classList.toggle('loss', total < 0); output.classList.toggle('profit', total > 0); } } };
  const saveDraft = () => { if (!form) return; localStorage.setItem(draftKey, JSON.stringify(Object.fromEntries(new FormData(form).entries()))); };
  const restoreDraft = () => { if (!form || selectedId) return; try { const draft = JSON.parse(localStorage.getItem(draftKey) || 'null'); if (!draft) return; for (const [name, value] of Object.entries(draft)) { const field = form.elements.namedItem(name); if (field && 'value' in field) field.value = String(value); } } catch {} };
  form?.addEventListener('input', () => { updateTotals(); window.clearTimeout(form.dataset.draftTimer); form.dataset.draftTimer = window.setTimeout(saveDraft, 350); }); form?.addEventListener('change', (event) => { const target = event.target; if (target instanceof HTMLInputElement && target.name.endsWith('_challenge')) { const result = target.closest('.item-editor')?.querySelector('.challenge-result'); result?.classList.toggle('is-visible', target.checked); } updateTotals(); });
  form?.addEventListener('keydown', (event) => { if (event.key === 'Enter' && event.target instanceof HTMLInputElement && event.target.type !== 'submit') event.preventDefault(); });
  form?.addEventListener('submit', () => { localStorage.removeItem(draftKey); for (const color of ['red', 'blue']) { const mode = document.querySelector(`[name="${color}_result_mode"]`); const finalValue = document.querySelector(`[name="${color}_final_profit"]`); const name = document.querySelector(`[name="${color}_item_1_name"]`); const buy = document.querySelector(`[name="${color}_item_1_buy"]`); const sell = document.querySelector(`[name="${color}_item_1_sell"]`); if (mode?.value === 'final' && name && buy && sell && finalValue) { name.value = 'Final result'; buy.value = '0'; sell.value = finalValue.value; } } });
  restoreDraft(); updateTotals();
</script>
