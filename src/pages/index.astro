---
import Layout from '../layouts/Layout.astro';
import { loadArchive, money, teamProfit, fileUrl } from '../lib/archive';

let details: any[] = [], performances: any[] = [], experts: any[] = [], errorMessage = '';
try { ({ details, performances, experts } = await loadArchive()); } catch (error) { errorMessage = 'PocketBase is unavailable. Check that the database container is running.'; console.error(error); }
const logged = details.filter((episode) => episode.isLogged);
const complete = details.filter((episode) => episode.isComplete);
const totalProfit = performances.reduce((sum, team) => sum + teamProfit(team), 0);
const recent = logged.slice(0, 3);
const fileUrlFor = (record: any, filename: string) => fileUrl(record, filename);
---
<Layout>
  <div class="shell landing-shell">
    <header class="topbar"><a class="brand" href="/" aria-label="Bargain Hunt home"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/log">Log</a><a href="/experts">Experts</a><a href="/stats">Stats</a></nav></header>
    <main>
      <section class="landing-hero"><div><p class="eyebrow">Bargain Hunt results board</p><h1>Let's go<br /><i>bargain hunting!</i></h1><p class="landing-lead">Keep the scores from the fair, the auction room and the final result in one place.</p><a class="hero-link" href="/log">Enter a result <span>↗</span></a></div><div class="landing-aside"><span class="aside-number">{details.length}</span><span>episodes<br />on the board</span></div></section>
      {errorMessage && <div class="notice error">{errorMessage}</div>}
      <section class="landing-stats"><div><span>Logged</span><strong>{logged.length}</strong><small>episodes with results</small></div><div><span>Complete</span><strong>{complete.length}</strong><small>both teams recorded</small></div><div><span>Tracked profit</span><strong>{money.format(totalProfit)}</strong><small>from entered results</small></div></section>
      <section class="section-heading landing-heading"><div><p class="eyebrow">The results board</p><h2>Yes? Yes!</h2></div><p class="muted">Pick a section.</p></section>
      <section class="route-grid" aria-label="Archive sections"><a class="route-card route-orange" href="/episodes"><span class="route-index">01</span><h3>Episode guide</h3><p>Browse every imported episode with its BBC image, synopsis and logging status.</p><span class="route-arrow">↗</span></a><a class="route-card route-blue" href="/log"><span class="route-index">02</span><h3>Episode rating</h3><p>Record team items, accepted bonuses, disqualified finds or a final profit figure.</p><span class="route-arrow">↗</span></a><a class="route-card route-dark" href="/experts"><span class="route-index">03</span><h3>Experts</h3><p>Meet the presenters and experts attached to the archive, with their portraits.</p><span class="route-arrow">↗</span></a><a class="route-card route-paper" href="/stats"><span class="route-index">04</span><h3>Statistics</h3><p>Compare Red and Blue, find the biggest wins and losses, and follow expert performance.</p><span class="route-arrow">↗</span></a></section>
      <section class="landing-recent"><div class="section-heading"><div><p class="eyebrow">Latest records</p><h2>Recent ratings.</h2></div><a class="text-link" href="/episodes">View all episodes <span>↗</span></a></div><div class="recent-grid">{recent.map((episode) => <a href={`/log?episode=${episode.id}`} class="recent-card">{episode.image ? <img src={fileUrlFor(episode, episode.image)} alt="" /> : <div class="recent-placeholder">BH</div>}<div><span>S{String(episode.series || 0).padStart(2, '0')} E{String(episode.episod_number || 0).padStart(2, '0')}</span><h3>{episode.title || 'Untitled episode'}</h3><p>{episode.winner ? `${episode.winner} team · ${money.format(episode.winnerProfit)}` : 'In progress'}</p></div></a>)}{!recent.length && <p class="empty">No rated episodes yet. Start with the episode guide.</p>}</div></section>
    </main>
    <footer><span>BARGAIN HUNT / FIELD NOTES</span><span>Private local archive</span></footer>
  </div>
</Layout>
