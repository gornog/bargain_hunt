---
import Layout from '../layouts/Layout.astro';
import { loadArchive, fileUrl } from '../lib/archive';
const { details } = await loadArchive();
const query = Astro.url.searchParams.get('q')?.toLowerCase() || '';
const series = Number(Astro.url.searchParams.get('series') || 0);
const filtered = details.filter((episode) => (!query || `${episode.title} ${episode.synopsis || ''}`.toLowerCase().includes(query)) && (!series || episode.series === series));
const imageUrl = (episode: any) => fileUrl(episode, episode.image);
---
<Layout><div class="shell"><header class="topbar"><a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/people">People</a><a href="/stats">Stats</a></nav><span class="status"><i></i> {filtered.length} catalogue records</span></header><main class="directory"><div class="page-intro"><p class="eyebrow">episode directory</p><h1>Every <i>find.</i></h1><p>Browse the BBC catalogue, then turn any unlogged record into a prepared field note.</p></div><form class="filters"><input name="q" value={query} placeholder="Search locations or synopsis" /><select name="series"><option value="0">All series</option>{[...new Set(details.map((e) => e.series).filter(Boolean))].sort((a,b) => b-a).map((n) => <option value={n} selected={series === n}>Series {n}</option>)}</select><button type="submit">Filter</button></form><div class="catalogue">{filtered.map((episode) => <article class="catalogue-card"><div class="catalogue-image">{episode.image ? <img src={imageUrl(episode)} alt="" /> : <span>No image</span>}</div><div class="catalogue-copy"><div class="catalogue-meta">Series {episode.series || '—'} · Episode {episode.episod_number || '—'} <span class={episode.isLogged ? 'logged' : 'unlogged'}>{episode.isLogged ? 'Logged' : 'Unlogged'}</span></div><h2>{episode.title || 'Untitled episode'}</h2><p>{episode.synopsis || 'Synopsis not available from the BBC guide.'}</p><a class="text-link" href={`/?episode=${episode.id}#log`}>{episode.isLogged ? 'Open record' : 'Prefill logger'} <span>↗</span></a></div></article>)}{!filtered.length && <p class="empty">No episodes match those filters.</p>}</div></main><footer><span>BARGAIN HUNT / FIELD NOTES</span><span>Catalogue · {filtered.length} records</span></footer></div></Layout>
