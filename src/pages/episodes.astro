---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadArchive, fileUrl } from '../lib/archive';
let details: any[] = [];
let errorMessage = '';
try { ({ details } = await loadArchive()); } catch (error) { errorMessage = 'PocketBase is unavailable. Check that the database container is running.'; console.error(error); }
const query = Astro.url.searchParams.get('q')?.toLowerCase() || '';
const series = Number(Astro.url.searchParams.get('series') || 0);
const status = Astro.url.searchParams.get('status') || 'all';
const sort = Astro.url.searchParams.get('sort') || 'catalogue';
const filtered = details.filter((episode) => (!query || `${episode.title} ${episode.synopsis || ''}`.toLowerCase().includes(query)) && (!series || episode.series === series) && (status === 'all' || episode.status === status)).sort((a, b) => sort === 'soon'
  ? (Date.parse(a.broadcast_date || '') || Number.MAX_SAFE_INTEGER) - (Date.parse(b.broadcast_date || '') || Number.MAX_SAFE_INTEGER) || Number(b.series) - Number(a.series) || Number(b.episod_number) - Number(a.episod_number)
  : Number(b.series) - Number(a.series) || Number(b.episod_number) - Number(a.episod_number) || Number(b.isLogged) - Number(a.isLogged));
const imageUrl = (episode: any) => fileUrl(episode, episode.image);
const episodeLabel = (episode: any) => Number(episode.episod_number) > 0 ? `Episode ${episode.episod_number}` : 'Special / unnumbered';
---
<Layout>
  <div class="shell">
    <SiteHeader current="/episodes" />
    <main class="directory">
      <div class="page-intro"><p class="eyebrow">the episode board</p><h1>Find the <i>lot.</i></h1><p>Browse fairs, locations and specials from the BBC catalogue. Pick a result to enter its auction figures.</p></div>
      {errorMessage && <div class="notice error">{errorMessage}</div>}
      <div class="episode-tools"><button class="bbc-refresh-button" id="bbc-refresh" type="button" title="Refresh episodes from BBC" aria-label="Refresh episodes from BBC"><span class="refresh-icon" aria-hidden="true">↻</span><span>Refresh BBC episodes</span></button><output id="bbc-refresh-status" aria-live="polite"></output></div>
      <form class="filters"><input name="q" value={query} placeholder="Search locations or synopsis" /><select name="series"><option value="0">All series</option>{[...new Set(details.map((e) => e.series).filter(Boolean))].sort((a,b) => b-a).map((n) => <option value={n} selected={series === n}>Series {n}</option>)}</select><select name="status"><option value="all" selected={status === 'all'}>All entries</option><option value="logged" selected={status === 'logged'}>Logged</option><option value="in-progress" selected={status === 'in-progress'}>In progress</option><option value="unlogged" selected={status === 'unlogged'}>Unlogged</option></select><select name="sort"><option value="catalogue" selected={sort !== 'soon'}>Catalogue order</option><option value="soon" selected={sort === 'soon'}>Showing soon</option></select><button type="submit">Filter</button></form>
      <div class="catalogue">{filtered.map((episode) => <article class="catalogue-card"><div class="catalogue-image">{episode.image ? <img src={imageUrl(episode)} alt={episode.title || 'Episode image'} /> : <span>No image</span>}</div><div class="catalogue-copy"><div class="catalogue-meta">Series {episode.series || 'n/a'} · {episodeLabel(episode)}{episode.broadcast_date && ` · ${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'Europe/London' }).format(new Date(episode.broadcast_date))}`} <span class={episode.status}>{episode.status === 'logged' ? 'Logged' : episode.status === 'in-progress' ? 'In progress' : 'Unlogged'}</span></div><h2>{episode.title || 'Untitled episode'}</h2><p>{episode.synopsis || 'Synopsis not available from the BBC guide.'}</p><div class="episode-actions"><a class="text-link" href={`/log?episode=${episode.id}`}>{episode.isLogged ? 'Open record' : 'Prefill logger'} <span>↗</span></a>{episode.watch && <a class="watch-link" href={episode.watch} target="_blank" rel="noreferrer">Watch on iPlayer <span>↗</span></a>}</div></div></article>)}{!filtered.length && <p class="empty">No episodes match those filters.</p>}</div>
    </main>
    <SiteFooter detail={`Catalogue · ${filtered.length} records`} />
  </div>
</Layout>
<script>
  const refreshButton = document.querySelector<HTMLButtonElement>('#bbc-refresh');
  const refreshStatus = document.querySelector<HTMLOutputElement>('#bbc-refresh-status');
  refreshButton?.addEventListener('click', async () => {
    refreshButton.disabled = true;
    refreshButton.classList.add('is-refreshing');
    if (refreshStatus) refreshStatus.textContent = 'Checking the BBC schedule…';
    try {
      const response = await fetch('/api/bbc-refresh?force=1', { method: 'POST' });
      if (response.status === 401) throw new Error('I couldn\'t refresh now — open Log and sign in first.');
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(`I couldn't refresh now — ${result.message || 'the BBC schedule did not respond.'}`);
      if (result.outcome === 'too_soon') {
        if (refreshStatus) refreshStatus.textContent = "I couldn't refresh now — the schedule was checked recently.";
        return;
      }
      if (result.outcome === 'no_changes' || (result.created === 0 && result.updated === 0)) {
        if (refreshStatus) refreshStatus.textContent = "Absolute death on it, no more episode/I can't refresh now";
        return;
      }
      if (refreshStatus) refreshStatus.textContent = `${result.created} added · ${result.updated} broadcast time${result.updated === 1 ? '' : 's'} refreshed`;
      window.setTimeout(() => window.location.reload(), 900);
    } catch (error) {
      if (refreshStatus) refreshStatus.textContent = error instanceof Error ? error.message : "I couldn't refresh now.";
    } finally {
      refreshButton.disabled = false;
      refreshButton.classList.remove('is-refreshing');
    }
  });
</script>
