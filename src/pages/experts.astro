---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadArchive, fileUrl, teamProfit, isGoldenGavel, isExpertGoldenGavel } from '../lib/archive';

let experts: any[] = [], performances: any[] = [], details: any[] = [], items: any[] = [];
let errorMessage = '';
try { ({ experts, performances, details, items } = await loadArchive()); } catch (error) { errorMessage = 'PocketBase is unavailable. Check that the database container is running.'; console.error(error); }
const portrait = (person: any) => fileUrl(person, person.avatar);
const relationIds = (record: any, field: string) => { const value = record?.[field]; if (Array.isArray(value)) return value; if (value) return [value]; const expanded = record?.expand?.[field]; return Array.isArray(expanded) ? expanded.map((entry: any) => entry.id) : expanded?.id ? [expanded.id] : []; };
const expertSummary = (expert: any) => { const rows = performances.filter((team: any) => team.expert === expert.id || team.expand?.expert?.id === expert.id); const wins = rows.filter((team: any) => { const episode = details.find((entry) => entry.id === team.episode); return episode?.winner === team.team_color; }).length; const losses = rows.length - wins; const bonuses = rows.filter((team: any) => team.bonus_accepted).length; const teamGolden = rows.filter(isGoldenGavel).length; const golden = rows.filter(isExpertGoldenGavel).length; return { wins, losses, bonuses, teamGolden, golden, profit: rows.reduce((sum, team) => sum + teamProfit(team), 0) }; };
const presenterSummary = (person: any) => ({ shows: details.filter((episode: any) => episode.isLogged && (episode.presenter === person.id || episode.expand?.presenter?.id === person.id)).length });
const auctioneerSummary = (person: any) => { const shows = details.filter((episode: any) => relationIds(episode, 'auctioneers').includes(person.id)); const ownItems = shows.flatMap((episode: any) => episode.teams.flatMap((team: any) => team.items || [])); const sold = ownItems.filter((item: any) => item.sell_price !== null && item.sell_price !== undefined && item.sell_price !== '' && !item.disqualified); const swing = sold.reduce((sum: number, item: any) => sum + Number(item.sell_price || 0) - Number(item.auctioneer_estimate || 0), 0); return { shows: shows.length, sold: sold.length, under: sold.filter((item: any) => Number(item.sell_price) < Number(item.auctioneer_estimate)).length, over: sold.filter((item: any) => Number(item.sell_price) > Number(item.auctioneer_estimate)).length, swing, houses: [...new Set(shows.map((episode: any) => episode.expand?.auction_house?.name).filter(Boolean))] }; };
const presenters = experts.filter((person) => person.is_presenter);
const roleExperts = experts.filter((person) => person.is_expert);
const auctioneers = experts.filter((person) => person.is_auctioneer);
const money = (amount: number) => `${amount < 0 ? '-' : ''}£${Math.abs(amount).toFixed(2)}`;
---
<Layout>
  <div class="shell">
    <SiteHeader current="/experts" />
    <main class="directory">
      <div class="page-intro"><p class="eyebrow">the people directory</p><h1>Meet the <i>people.</i></h1><p>Browse presenters, antiques experts and auctioneers separately, with the statistic that matters for each role.</p></div>
      {errorMessage && <div class="notice error">{errorMessage}</div>}
      <div class="people-accordions">
        <details class="people-accordion" open><summary><span><strong>Presenters</strong><small>{presenters.length} people · {presenters.reduce((sum, person) => sum + presenterSummary(person).shows, 0)} logged shows</small></span><b>＋</b></summary><div class="people-grid">{presenters.map((person) => { const stats = presenterSummary(person); return <article class="person-card flip-card"><div class="flip-inner"><div class="flip-front"><div>{person.avatar ? <img src={portrait(person)} alt={person.name} /> : <span class="portrait-placeholder">{person.name.slice(0, 1)}</span>}</div><h2>{person.name}</h2><p>Presenter</p><small>Tap or hover for record</small></div><div class="flip-back"><h2>{person.name}</h2><strong>{stats.shows}</strong><p>Logged shows presented</p><dl><div><dt>Shows</dt><dd>{stats.shows}</dd></div></dl></div></div></article>; })}{!presenters.length && <p class="empty">No presenters recorded.</p>}</div></details>
        <details class="people-accordion" open><summary><span><strong>Experts</strong><small>{roleExperts.length} people · assigned to team performances</small></span><b>＋</b></summary><div class="people-grid">{roleExperts.map((person) => { const stats = expertSummary(person); return <article class="person-card flip-card"><div class="flip-inner"><div class="flip-front"><div>{person.avatar ? <img src={portrait(person)} alt={person.name} /> : <span class="portrait-placeholder">{person.name.slice(0, 1)}</span>}</div><h2>{person.name}</h2><p>Expert{person.is_presenter ? ' · Presenter' : ''}</p><small>Tap or hover for record</small></div><div class="flip-back"><h2>{person.name}</h2><strong>{money(stats.profit)}</strong><p>Net recorded result</p><dl><div><dt>Team wins</dt><dd>{stats.wins}</dd></div><div><dt>Team losses</dt><dd>{stats.losses}</dd></div><div><dt>Bonus buys</dt><dd>{stats.bonuses}</dd></div><div><dt>Team gavels</dt><dd>{stats.teamGolden}</dd></div><div><dt>Expert gavels</dt><dd>{stats.golden}</dd></div></dl></div></div></article>; })}{!roleExperts.length && <p class="empty">No experts recorded.</p>}</div></details>
        <details class="people-accordion"><summary><span><strong>Auctioneers</strong><small>{auctioneers.length} people · open for sale statistics</small></span><b>＋</b></summary><div class="people-grid">{auctioneers.map((person) => { const stats = auctioneerSummary(person); return <article class="person-card flip-card"><div class="flip-inner"><div class="flip-front"><div>{person.avatar ? <img src={portrait(person)} alt={person.name} /> : <span class="portrait-placeholder">{person.name.slice(0, 1)}</span>}</div><h2>{person.name}</h2><p>Auctioneer</p><small>Tap or hover for record</small></div><div class="flip-back"><h2>{person.name}</h2><strong>{money(stats.swing)}</strong><p>Swing versus top estimate</p><dl><div><dt>Auction houses</dt><dd>{stats.houses.length || '—'}</dd></div><div><dt>Shows</dt><dd>{stats.shows}</dd></div><div><dt>Items sold</dt><dd>{stats.sold}</dd></div><div><dt>Under estimate</dt><dd>{stats.under}</dd></div><div><dt>Over estimate</dt><dd>{stats.over}</dd></div></dl>{stats.houses.length > 0 && <small class="auction-house-list">{stats.houses.join(' · ')}</small>}</div></div></article>; })}{!auctioneers.length && <p class="empty">No auctioneer recorded.</p>}</div></details>
      </div>
    </main>
    <SiteFooter detail={`${experts.length} people in the directory`} />
  </div>
</Layout>
