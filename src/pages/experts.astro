---
import Layout from '../layouts/Layout.astro';
import { loadArchive, fileUrl } from '../lib/archive';

const { experts } = await loadArchive();
const portrait = (expert: any) => fileUrl(expert, expert.avatar);
---
<Layout>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a>
      <nav aria-label="Main navigation"><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/experts">Experts</a><a href="/stats">Stats</a></nav>
    </header>
    <main class="directory">
      <div class="page-intro"><p class="eyebrow">expert directory</p><h1>The faces of the <i>hunt.</i></h1><p>Presenters and experts who make each episode worth watching, with portraits ready for the archive.</p></div>
      <div class="people-grid">
        {experts.map((expert: any) => <article class="person-card"><div>{expert.avatar ? <img src={portrait(expert)} alt={expert.name} /> : <span class="portrait-placeholder">{expert.name.slice(0, 1)}</span>}</div><h2>{expert.name}</h2><p>{[expert.is_presenter && 'Presenter', expert.is_expert && 'Expert'].filter(Boolean).join(' · ') || 'Archive contributor'}</p></article>)}
      </div>
    </main>
    <footer><span>BARGAIN HUNT / FIELD NOTES</span><span>{experts.length} experts in the directory</span></footer>
  </div>
</Layout>
