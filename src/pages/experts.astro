---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadArchive, fileUrl, teamProfit, isGoldenGavel, isExpertGoldenGavel } from '../lib/archive';

let experts: any[] = [], performances: any[] = [], details: any[] = [];
let errorMessage = '';
try { ({ experts, performances, details } = await loadArchive()); } catch (error) { errorMessage = 'PocketBase is unavailable. Check that the database container is running.'; console.error(error); }
const portrait = (expert: any) => fileUrl(expert, expert.avatar);
const expertSummary = (expert: any) => { const rows = performances.filter((team: any) => team.expert === expert.id || team.expand?.expert?.id === expert.id); const wins = rows.filter((team: any) => { const episode = details.find((entry) => entry.id === team.episode); return episode?.winner === team.team_color; }).length; const losses = rows.length - wins; const bonuses = rows.filter((team: any) => team.bonus_accepted).length; const teamGolden = rows.filter(isGoldenGavel).length; const golden = rows.filter(isExpertGoldenGavel).length; return { wins, losses, bonuses, teamGolden, golden, profit: rows.reduce((sum, team) => sum + teamProfit(team), 0) }; };
---
<Layout>
  <div class="shell">
    <SiteHeader current="/experts" />
    <main class="directory">
      <div class="page-intro"><p class="eyebrow">the experts</p><h1>Meet the <i>experts.</i></h1><p>The presenters and antiques experts who call the shots at the fair and in the auction room.</p></div>
      {errorMessage && <div class="notice error">{errorMessage}</div>}
      <div class="people-grid">
        {experts.map((expert: any) => { const stats = expertSummary(expert); return <article class="person-card flip-card"><div class="flip-inner"><div class="flip-front"><div>{expert.avatar ? <img src={portrait(expert)} alt={expert.name} /> : <span class="portrait-placeholder">{expert.name.slice(0, 1)}</span>}</div><h2>{expert.name}</h2><p>{[expert.is_presenter && 'Presenter', expert.is_expert && 'Expert', expert.is_auctioneer && 'Auctioneer'].filter(Boolean).join(' · ') || 'Archive contributor'}</p><small>Tap or hover for record</small></div><div class="flip-back"><h2>{expert.name}</h2><strong>{stats.profit < 0 ? '-' : ''}£{Math.abs(stats.profit).toFixed(2)}</strong><p>Net recorded result</p><dl><div><dt>Team wins</dt><dd>{stats.wins}</dd></div><div><dt>Team losses</dt><dd>{stats.losses}</dd></div><div><dt>Bonus buys</dt><dd>{stats.bonuses}</dd></div><div><dt>Team gavels</dt><dd>{stats.teamGolden}</dd></div><div><dt>Expert gavels</dt><dd>{stats.golden}</dd></div></dl></div></div></article>; })}
      </div>
    </main>
    <SiteFooter detail={`${experts.length} experts in the directory`} />
  </div>
</Layout>
