---
import Layout from '../layouts/Layout.astro';
import { loadArchive, fileUrl } from '../lib/archive';
const { experts } = await loadArchive();
const imageUrl = (expert: any) => fileUrl(expert, expert.avatar);
---
<Layout><div class="shell"><header class="topbar"><a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/people">People</a><a href="/stats">Stats</a></nav><span class="status"><i></i> People directory</span></header><main class="directory"><div class="page-intro"><p class="eyebrow">the people</p><h1>Faces of the <i>hunt.</i></h1><p>Presenters and experts gathered from the BBC programme archive.</p></div><div class="people-grid">{experts.map((expert: any) => <article class="person-card">{expert.avatar ? <img src={imageUrl(expert)} alt="" /> : <div class="person-placeholder">{expert.name?.slice(0, 1)}</div>}<div><h2>{expert.name}</h2><p>{[expert.is_presenter && 'Presenter', expert.is_expert && 'Expert'].filter(Boolean).join(' · ') || 'Bargain Hunt contributor'}</p></div></article>)}</div></main><footer><span>BARGAIN HUNT / FIELD NOTES</span><span>{experts.length} people</span></footer></div></Layout>
