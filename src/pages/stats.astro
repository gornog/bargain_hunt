---
import Layout from '../layouts/Layout.astro';
import { loadArchive, teamProfit, money, hasTeamData } from '../lib/archive';
const { details, performances, experts } = await loadArchive();
const logged = details.filter((episode) => episode.isLogged);
const teams = performances.filter(hasTeamData).map((team: any) => ({ ...team, profit: teamProfit(team) }));
const red = teams.filter((team: any) => team.team_color === 'Red');
const blue = teams.filter((team: any) => team.team_color === 'Blue');
const total = (rows: any[]) => rows.reduce((sum, row) => sum + row.profit, 0);
const redTotal = total(red); const blueTotal = total(blue); const chartMax = Math.max(Math.abs(redTotal), Math.abs(blueTotal), 1);
const biggestWin = [...teams].sort((a,b) => b.profit - a.profit)[0]; const biggestLoss = [...teams].sort((a,b) => a.profit - b.profit)[0];
const expertStats = experts.map((expert: any) => { const rows = teams.filter((team: any) => team.expert === expert.id || team.expand?.expert?.id === expert.id); return { ...expert, count: rows.length, profit: total(rows) }; }).filter((expert: any) => expert.count).sort((a,b) => b.profit-a.profit);
const episodeLabel = (team: any) => team?.expand?.episode?.title || 'Untitled episode';
---
<Layout>
  <div class="shell">
    <header class="topbar"><a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/experts">Experts</a><a href="/stats">Stats</a></nav></header>
    <main class="directory">
      <div class="page-intro"><p class="eyebrow">the numbers</p><h1>Patterns in the <i>profit.</i></h1><p>Only records with actual team data count here. Catalogue-only episodes stay out of the maths.</p></div>
      <section class="stats-grid stats-grid-three" aria-label="Summary statistics"><div class="stat"><span>Logged episodes</span><strong>{logged.length}</strong><small>of {details.length} catalogue records</small></div><div class="stat"><span>Red team profit</span><strong>{money.format(redTotal)}</strong><small>{red.length} recorded teams</small></div><div class="stat"><span>Blue team profit</span><strong>{money.format(blueTotal)}</strong><small>{blue.length} recorded teams</small></div></section>
      <section class="chart-block" aria-labelledby="team-chart-title"><h2 id="team-chart-title">Team performance</h2><div class="chart-row"><span>Red</span><div class="chart-track"><i style={`width:${Math.max(3, Math.abs(redTotal) / chartMax * 100)}%`}></i></div><strong>{money.format(redTotal)}</strong></div><div class="chart-row blue"><span>Blue</span><div class="chart-track"><i style={`width:${Math.max(3, Math.abs(blueTotal) / chartMax * 100)}%`}></i></div><strong>{money.format(blueTotal)}</strong></div></section>
      <div class="highlights"><article><span>Biggest win</span><strong>{biggestWin ? money.format(biggestWin.profit) : '—'}</strong><p>{biggestWin ? `${biggestWin.team_color} team · ${episodeLabel(biggestWin)}` : 'Add sale prices to reveal this.'}</p></article><article><span>Biggest loss</span><strong>{biggestLoss ? money.format(biggestLoss.profit) : '—'}</strong><p>{biggestLoss ? `${biggestLoss.team_color} team · ${episodeLabel(biggestLoss)}` : 'Add purchase prices to reveal this.'}</p></article></div>
      <h2 class="subheading">Expert performance</h2><div class="leaderboard">{expertStats.map((expert: any, index) => <div class="leader"><span class="rank">{String(index+1).padStart(2,'0')}</span><span class="expert-name">{expert.name}<small>{expert.count} recorded team{expert.count === 1 ? '' : 's'}</small></span><span class="bar"><i style={`width:${Math.max(8, Math.min(100, expert.profit / Math.max(expertStats[0]?.profit || 1, 1) * 100))}%`}></i></span><strong>{money.format(expert.profit)}</strong></div>)}{!expertStats.length && <p class="empty">No team data has been logged yet.</p>}</div>
    </main><footer><span>BARGAIN HUNT / FIELD NOTES</span><span>Calculated live from PocketBase</span></footer>
  </div>
</Layout>
