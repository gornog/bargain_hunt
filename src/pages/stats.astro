---
import Layout from '../layouts/Layout.astro';
import { loadArchive, teamProfit, money, hasTeamData, isGoldenGavel, isExpertGoldenGavel } from '../lib/archive';
const { details, performances, experts, items, auctionHouses } = await loadArchive();
const logged = details.filter((episode) => episode.isLogged);
const teams = performances.filter(hasTeamData).map((team: any) => ({ ...team, profit: teamProfit(team) }));
const red = teams.filter((team: any) => team.team_color === 'Red');
const blue = teams.filter((team: any) => team.team_color === 'Blue');
const total = (rows: any[]) => rows.reduce((sum, row) => sum + row.profit, 0);
const redTotal = total(red); const blueTotal = total(blue); const chartMax = Math.max(Math.abs(redTotal), Math.abs(blueTotal), 1);
const divergingBar = (amount: number, maximum: number) => {
  const width = Math.abs(amount) / maximum * 50;
  return amount < 0 ? `right:50%;width:${width}%` : `left:50%;width:${width}%`;
};
const biggestWin = [...teams].sort((a,b) => b.profit - a.profit)[0]; const biggestLoss = [...teams].sort((a,b) => a.profit - b.profit)[0];
const expertStats = experts.map((expert: any) => { const rows = teams.filter((team: any) => team.expert === expert.id || team.expand?.expert?.id === expert.id); return { ...expert, count: rows.length, teamGolden: rows.filter(isGoldenGavel).length, expertGolden: rows.filter(isExpertGoldenGavel).length, profit: total(rows) }; }).filter((expert: any) => expert.count).sort((a,b) => b.profit-a.profit);
const expertChartMax = Math.max(...expertStats.map((expert: any) => Math.abs(expert.profit)), 1);
const episodeLabel = (team: any) => team?.expand?.episode?.title || 'Untitled episode';
const wins = (colour: string) => details.filter((episode) => episode.winner === colour).length;
const goldenTeams = teams.filter(isGoldenGavel);
const hasNumber = (value: unknown) => value !== null && value !== undefined && value !== '' && Number.isFinite(Number(value));
const performanceById = new Map(performances.map((performance: any) => [performance.id, performance]));
const itemRows = items.filter((item: any) => item.name).map((item: any) => ({ ...item, profit: Number(item.sell_price || 0) - Number(item.buy_price || 0) })).sort((a: any, b: any) => b.profit - a.profit);
const worstLots = [...itemRows].sort((a: any, b: any) => a.profit - b.profit);
const deviationRows = items.filter((item: any) => item.auctioneer_estimate).map((item: any) => ({ ...item, deviation: Number(item.sell_price || 0) - Number(item.auctioneer_estimate || 0) })).sort((a: any, b: any) => b.deviation - a.deviation);
const itemScatter = items.filter((item: any) => item.name && hasNumber(item.buy_price) && hasNumber(item.sell_price) && hasNumber(item.auctioneer_estimate)).map((item: any) => {
  const performance = performanceById.get(item.team_performance);
  const episode = performance?.expand?.episode;
  const profit = Number(item.sell_price) - Number(item.buy_price);
  const estimateDelta = Number(item.sell_price) - Number(item.auctioneer_estimate);
  return { ...item, profit, estimateDelta, episodeLabel: episode ? `S${episode.series || '?'} E${episode.episod_number || '?'} · ${episode.title || 'Untitled episode'}` : 'Episode not linked' };
});
const scatterXRange = Math.max(...itemScatter.map((item: any) => Math.abs(item.profit)), 1);
const scatterYRange = Math.max(...itemScatter.map((item: any) => Math.abs(item.estimateDelta)), 1);
const scatterX = (profit: number) => 50 + (profit / scatterXRange) * 43;
const scatterY = (estimateDelta: number) => 50 - (estimateDelta / scatterYRange) * 39;
const houseStats = auctionHouses.map((house: any) => { const rows = details.filter((episode) => episode.auction_house === house.id); return { ...house, count: rows.length }; }).filter((house: any) => house.count);
const auctioneerStats = experts.filter((person: any) => person.is_auctioneer).map((auctioneer: any) => { const episodes = details.filter((episode: any) => (episode.auctioneer_people || []).includes(auctioneer.id)); return { ...auctioneer, count: episodes.length }; }).filter((person: any) => person.count);
const profitBins = [
  { label: '≤ −£100', min: -Infinity, max: -100.01 },
  { label: '−£100 to −£1', min: -100, max: -0.01 },
  { label: '£0 to £99', min: 0, max: 99.99 },
  { label: '£100 to £249', min: 100, max: 249.99 },
  { label: '£250+', min: 250, max: Infinity }
].map((bin) => ({ ...bin, count: teams.filter((team: any) => team.profit >= bin.min && team.profit <= bin.max).length }));
const histogramMax = Math.max(...profitBins.map((bin) => bin.count), 1);
const episodeSeries = details.filter((episode) => episode.isLogged).map((episode) => ({
  label: `S${episode.series || '?'} E${episode.episod_number || '?'}`,
  profit: episode.scored.reduce((sum: number, team: any) => sum + team.profit, 0)
})).reverse();
const episodeRange = Math.max(...episodeSeries.map((episode) => Math.abs(episode.profit)), 1);
---
<Layout>
  <div class="shell">
    <header class="topbar"><a class="brand" href="/"><span class="brand-mark">BH</span><span>Bargain Hunt <em>field notes</em></span></a><nav aria-label="Main navigation"><a href="/">Overview</a><a href="/episodes">Episodes</a><a href="/log">Log</a><a href="/experts">Experts</a><a href="/stats">Stats</a></nav></header>
    <main class="directory">
      <div class="page-intro"><p class="eyebrow">the score board</p><h1>Who made the <i>profit?</i></h1><p>Compare the Reds and Blues, check the best buys and see which experts have the eye for it.</p></div>
      <section class="stats-grid stats-grid-three" aria-label="Summary statistics"><div class="stat"><span>Logged episodes</span><strong>{logged.length}</strong><small>of {details.length} catalogue records</small></div><div class="stat"><span>Red team record</span><strong>{wins('Red')} wins</strong><small>{money.format(redTotal)} net · {red.length} teams</small></div><div class="stat"><span>Blue team record</span><strong>{wins('Blue')} wins</strong><small>{money.format(blueTotal)} net · {blue.length} teams</small></div></section>
      <section class="chart-block" aria-labelledby="team-chart-title"><h2 id="team-chart-title">Team performance</h2><p class="chart-note">Net recorded result. The centre line is £0; bars extending left are losses.</p><div class="chart-row"><span>Red</span><div class="chart-track diverging-track" aria-label={`Red: ${money.format(redTotal)}`}><b aria-hidden="true"></b><i class:list={[redTotal < 0 && 'negative']} style={divergingBar(redTotal, chartMax)}></i></div><strong>{money.format(redTotal)}</strong></div><div class="chart-row blue"><span>Blue</span><div class="chart-track diverging-track" aria-label={`Blue: ${money.format(blueTotal)}`}><b aria-hidden="true"></b><i class:list={[blueTotal < 0 && 'negative']} style={divergingBar(blueTotal, chartMax)}></i></div><strong>{money.format(blueTotal)}</strong></div></section>
      <section class="stats-figures" aria-label="Detailed statistical visualisations">
        <figure class="stat-figure">
          <figcaption><span class="eyebrow">distribution</span><h2>Team profit histogram</h2><p>How often a recorded team lands in each profit band.</p></figcaption>
          <div class="histogram" role="img" aria-label={`Histogram of ${teams.length} recorded team profits`}>
            {profitBins.map((bin) => <div class="histogram-bin"><span class="histogram-count">{bin.count}</span><i style={`height:${Math.max(bin.count ? 10 : 0, bin.count / histogramMax * 100)}%`}></i><span class="histogram-label">{bin.label}</span></div>)}
          </div>
          {!teams.length && <p class="empty">Add completed team results to populate the histogram.</p>}
        </figure>
        <figure class="stat-figure">
          <figcaption><span class="eyebrow">sequence</span><h2>Net result by episode</h2><p>Combined Red and Blue result for every logged episode.</p></figcaption>
          <div class="episode-plot" role="img" aria-label={`Net profit by logged episode, from ${episodeSeries.length} episodes`}>
            <div class="plot-zero" aria-hidden="true"></div>
            {episodeSeries.map((episode) => <div class:list={['episode-mark', episode.profit < 0 && 'negative']} title={`${episode.label}: ${money.format(episode.profit)}`}><i style={`height:${Math.max(episode.profit ? 8 : 0, Math.abs(episode.profit) / episodeRange * 50)}%; ${episode.profit >= 0 ? 'bottom:50%' : 'top:50%'}`}></i><span>{episode.label}</span></div>)}
          </div>
          {!episodeSeries.length && <p class="empty">Log a team result to plot the archive over time.</p>}
        </figure>
      </section>
      <figure class="stat-figure scatter-figure">
        <figcaption><span class="eyebrow">lots · realised price versus estimate</span><h2>Item result distribution</h2><p>Each point is a recorded lot. Move over a point for the item and episode: horizontal position is sale price minus purchase price; vertical position is sale price minus the auctioneer estimate.</p></figcaption>
        <div class="scatter-wrap">
          <span class="scatter-y-label">Sale − estimate</span>
          <svg class="item-scatter" viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label={`Scatter plot of ${itemScatter.length} recorded lots; horizontal axis is sale minus purchase and vertical axis is sale minus estimate`}>
            <line class="scatter-axis" x1="7" y1="50" x2="93" y2="50"></line><line class="scatter-axis" x1="50" y1="8" x2="50" y2="92"></line>
            {itemScatter.map((item: any) => <circle class:list={['scatter-point', item.profit < 0 && 'loss', item.estimateDelta < 0 && 'below-estimate']} cx={scatterX(item.profit)} cy={scatterY(item.estimateDelta)} r="1.65"><title>{`${item.name} · ${item.episodeLabel}\nProfit: ${money.format(item.profit)}\nSale minus estimate: ${money.format(item.estimateDelta)}`}</title></circle>)}
          </svg>
          <span class="scatter-x-label">Sale − purchase</span>
          <span class="scatter-zero scatter-zero-y">£0</span><span class="scatter-zero scatter-zero-x">£0</span>
        </div>
        {!itemScatter.length && <p class="empty">Add a buy price, sale price, and auctioneer estimate to plot a lot.</p>}
      </figure>
      <div class="highlights"><article><span>Biggest win</span><strong>{biggestWin ? money.format(biggestWin.profit) : 'n/a'}</strong><p>{biggestWin ? `${biggestWin.team_color} team · ${episodeLabel(biggestWin)}` : 'Add sale prices to reveal this.'}</p></article><article><span>Biggest loss</span><strong>{biggestLoss ? money.format(biggestLoss.profit) : 'n/a'}</strong><p>{biggestLoss ? `${biggestLoss.team_color} team · ${episodeLabel(biggestLoss)}` : 'Add purchase prices to reveal this.'}</p></article></div>
      <h2 class="subheading">Expert performance</h2><div class="leaderboard">{expertStats.map((expert: any, index) => <div class="leader"><span class="rank">{String(index+1).padStart(2,'0')}</span><span class="expert-name">{expert.name}<small>{expert.count} recorded team{expert.count === 1 ? '' : 's'} · Team gavels {expert.teamGolden} · Expert gavels {expert.expertGolden}</small></span><span class="bar diverging-bar" aria-label={`${expert.name}: ${money.format(expert.profit)} `}><b aria-hidden="true"></b><i class:list={[expert.profit < 0 && 'negative']} style={divergingBar(expert.profit, expertChartMax)}></i></span><strong>{money.format(expert.profit)}</strong></div>)}{!expertStats.length && <p class="empty">No team data has been logged yet.</p>}</div>
      <section class="stats-extra"><article><span>Golden Gavels</span><strong>{goldenTeams.length}</strong><p>Teams with three profitable lots.</p></article><article><span>Items recorded</span><strong>{itemRows.length}</strong><p>Lots with a description.</p></article><article><span>Average estimate swing</span><strong>{deviationRows.length ? money.format(deviationRows.reduce((sum, item) => sum + item.deviation, 0) / deviationRows.length) : 'n/a'}</strong><p>Sale price versus top estimate.</p></article></section>
      <div class="stats-columns"><section><h2 class="subheading">Worst individual lots</h2><div class="stat-list">{worstLots.slice(0, 10).map((item: any) => <div><strong>{item.name}</strong><span>{money.format(item.profit)}</span></div>)}{!itemRows.length && <p class="empty">No item records yet.</p>}</div></section><section><h2 class="subheading">Estimate deviation</h2><div class="stat-list">{deviationRows.slice(0, 10).map((item: any) => <div><strong>{item.name}</strong><span>{item.deviation >= 0 ? '+' : ''}{money.format(item.deviation)}</span></div>)}{!deviationRows.length && <p class="empty">Add auctioneer estimates to see this.</p>}</div></section></div>
    </main><footer><span>BARGAIN HUNT / FIELD NOTES</span><span>Calculated live from PocketBase</span></footer>
  </div>
</Layout>
